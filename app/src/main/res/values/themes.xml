<resources>
    <!-- Dark parent + explicit dark windowBackground so the OS-drawn window
         background never flashes white during activity launch or screen
         transitions before Compose paints the real terminal background. -->
    <style name="Theme.Termi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/terminal_background</item>
        <item name="android:navigationBarColor">@color/terminal_background</item>
        <item name="android:statusBarColor">@color/terminal_background</item>
    </style>
</resources>
